# Quoro control plane: the API, the panel and the node sessions (ADR 0089).
#
# Installed by installer/install.sh to /etc/systemd/system/quoro.service on a
# primary and shipped inside the release tarball as quoro.service. The node
# agent, which keeps the privileges the engine needs, is quoro-node.service.

[Unit]
Description=Quoro control plane (API and panel)
Documentation=https://github.com/OmarAlex24/quoro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unprivileged (ADR 0089): the control plane signs desired state and never
# touches a hypervisor, a bridge or a firewall. Port 8443 needs no capability.
User=quoro-api
Group=quoro-api
Environment=QUORO_CONFIG=/etc/quoro/quoro.toml
ExecStart=/usr/local/bin/quoro serve
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
RestartPreventExitStatus=78
# No capability can be gained: the bounding and ambient sets are empty and
# setuid binaries do not elevate.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
# The only writable path is the data directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/quoro
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
# Logs go to journald: read them with journalctl -u quoro.

[Install]
WantedBy=multi-user.target
