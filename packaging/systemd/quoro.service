# Quoro: one microVM per app on Cloud Hypervisor + KVM.
#
# Installed by installer/install.sh to /etc/systemd/system/quoro.service and
# shipped inside the release tarball as quoro.service.

[Unit]
Description=Quoro (hypervisor and app deploy)
Documentation=https://github.com/OmarAlex24/quoro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root: the engine creates the quoro0 bridge and TAP devices, writes
# the nftables rules that route guest traffic, and converts images with their
# ownership preserved.
Environment=QUORO_CONFIG=/etc/quoro/quoro.toml
ExecStart=/usr/local/bin/quoro serve
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
# quoro serve exits 78 when this host cannot run the engine: no /dev/kvm, no
# vmx/svm, a kernel that is too old, or missing artifacts. Restarting would not
# help, so let the unit stay failed and read the journal instead.
RestartPreventExitStatus=78
# Hardening the engine tolerates. It writes /proc/sys/net/ipv4/ip_forward,
# opens /dev/kvm and /dev/net/tun and talks netlink, so PrivateDevices,
# ProtectKernelTunables, ProtectKernelModules, RestrictAddressFamilies and
# CapabilityBoundingSet are deliberately not set here.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full
# Logs go to journald by default: read them with journalctl -u quoro.

[Install]
WantedBy=multi-user.target
