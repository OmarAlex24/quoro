{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quoro.dev/schemas/events/v1.json",
  "title": "Quoro event",
  "description": "One Quoro event. The envelope is identical everywhere it appears: on the SSE stream (GET /api/v1/events/stream), in GET /api/v1/events, in webhook delivery bodies, and in node-agent `event` messages. A node-agent `event` message carries the same envelope without `seq`: the node assigns `id` when it emits the event, and the primary assigns `seq` on receipt, so `seq` is required for every event that a client reads from the API, the stream or a webhook. The node-agent protocol document defines that message form. The `$id` URL is a placeholder identifier; this schema is published inside the repository, not fetched from that address. Payloads are additive within schema_version 1. Id prefixes, status enums and event types are the shared vocabulary of docs/contracts/README.md; the event log is the notify step of the AI-native loop (D-0032) and the envelope carries the incident and grant context that the loop needs (D-0030, D-0031).",

  "type": "object",
  "required": ["schema_version", "id", "seq", "type", "time", "source", "subject", "data"],
  "additionalProperties": false,

  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Envelope version. New optional payload fields do not change it; a breaking change does."
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Event id, assigned by the emitter (the control plane or the node agent)."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Gap-free position in the event log, assigned by the primary when it accepts the event."
    },
    "type": {
      "type": "string",
      "description": "Event type, `<subject>.<what>`.",
      "enum": [
        "node.enrolled",
        "node.connected",
        "node.disconnected",
        "node.fenced",
        "node.disk_low",
        "vm.created",
        "vm.started",
        "vm.stopped",
        "vm.crashed",
        "vm.deleted",
        "app.created",
        "app.updated",
        "app.deleted",
        "app.down",
        "app.up",
        "app.restarted",
        "deployment.started",
        "deployment.succeeded",
        "deployment.failed",
        "certificate.issued",
        "certificate.expiring",
        "certificate.failed",
        "grant.created",
        "grant.revoked",
        "grant.expired",
        "approval.requested",
        "approval.approved",
        "approval.denied",
        "approval.expired",
        "incident.opened",
        "incident.resolved",
        "audit.chain_broken"
      ]
    },
    "time": { "$ref": "#/$defs/Timestamp" },
    "source": { "$ref": "#/$defs/Source" },
    "subject": { "$ref": "#/$defs/Subject" },
    "project_id": { "$ref": "#/$defs/ProjectId" },
    "incident_id": { "$ref": "#/$defs/IncidentId" },
    "request_id": { "$ref": "#/$defs/RequestId" },
    "actor": { "$ref": "#/$defs/Actor" },
    "data": {
      "type": "object",
      "description": "Type-specific payload. The schema for this object is fixed by `type` in the allOf below."
    }
  },

  "allOf": [
    { "if": { "required": ["type"], "properties": { "type": { "const": "node.enrolled" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_node_enrolled" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "node.connected" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_node_connected" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "node.disconnected" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_node_disconnected" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "node.fenced" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_node_fenced" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "node.disk_low" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_node_disk_low" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "vm.created" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_vm_created" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "vm.started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_vm_started" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "vm.stopped" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_vm_stopped" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "vm.crashed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_vm_crashed" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "vm.deleted" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_vm_deleted" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "app.created" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_app_created" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "app.updated" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_app_updated" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "app.deleted" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_app_deleted" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "app.down" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_app_down" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "app.up" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_app_up" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "app.restarted" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_app_restarted" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "deployment.started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_deployment_started" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "deployment.succeeded" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_deployment_succeeded" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "deployment.failed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_deployment_failed" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "certificate.issued" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_certificate_issued" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "certificate.expiring" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_certificate_expiring" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "certificate.failed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_certificate_failed" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "grant.created" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_grant_created" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "grant.revoked" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_grant_revoked" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "grant.expired" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_grant_expired" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "approval.requested" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_approval_requested" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "approval.approved" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_approval_approved" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "approval.denied" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_approval_denied" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "approval.expired" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_approval_expired" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "incident.opened" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_incident_opened" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "incident.resolved" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_incident_resolved" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "audit.chain_broken" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data_audit_chain_broken" } } } }
  ],

  "$defs": {
    "ClusterId": { "type": "string", "pattern": "^cls_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Cluster id (`cls_` + ULID)." },
    "NodeId": { "type": "string", "pattern": "^nod_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Node id (`nod_` + ULID)." },
    "NodeJoinTokenId": { "type": "string", "pattern": "^njt_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Node join token id (`njt_` + ULID)." },
    "ProjectId": { "type": "string", "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Project id (`prj_` + ULID)." },
    "VmId": { "type": "string", "pattern": "^vm_[0-9A-HJKMNP-TV-Z]{26}$", "description": "VM id (`vm_` + ULID)." },
    "AppId": { "type": "string", "pattern": "^app_[0-9A-HJKMNP-TV-Z]{26}$", "description": "App id (`app_` + ULID)." },
    "DeploymentId": { "type": "string", "pattern": "^dep_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Deployment id (`dep_` + ULID)." },
    "DomainId": { "type": "string", "pattern": "^dom_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Domain id (`dom_` + ULID)." },
    "VolumeId": { "type": "string", "pattern": "^vol_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Volume id (`vol_` + ULID)." },
    "LeaseId": { "type": "string", "pattern": "^lse_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Lease id (`lse_` + ULID)." },
    "UserId": { "type": "string", "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Human user id (`usr_` + ULID)." },
    "ApiTokenId": { "type": "string", "pattern": "^tok_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Human API token id (`tok_` + ULID)." },
    "AgentId": { "type": "string", "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Agent id (`agt_` + ULID)." },
    "AgentKeyId": { "type": "string", "pattern": "^akey_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Agent key id (`akey_` + ULID)." },
    "AccessTokenId": { "type": "string", "pattern": "^atk_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Agent access token id (`atk_` + ULID)." },
    "GrantId": { "type": "string", "pattern": "^grt_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Grant id (`grt_` + ULID)." },
    "ApprovalId": { "type": "string", "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Approval request id (`apr_` + ULID)." },
    "IncidentId": { "type": "string", "pattern": "^inc_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Incident id (`inc_` + ULID)." },
    "EventId": { "type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Event id (`evt_` + ULID)." },
    "WebhookId": { "type": "string", "pattern": "^whk_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Webhook id (`whk_` + ULID)." },
    "WebhookDeliveryId": { "type": "string", "pattern": "^whd_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Webhook delivery id (`whd_` + ULID)." },
    "RequestId": { "type": "string", "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Correlation id of one API or MCP call (`req_` + ULID)." },

    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC, for example `2026-11-02T09:15:00Z`."
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 digest, 64 characters."
    },
    "Scope": {
      "type": "string",
      "pattern": "^(cluster|node|project|vm|app|agent|grant|approval|incident|audit|event|webhook|user):[a-z_]+$",
      "description": "One scope, `<resource>:<verb>`; the complete list is in the contracts README."
    },

    "Source": {
      "type": "object",
      "description": "Where the event was emitted: the control plane itself, or a specific node.",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["control_plane", "node"] },
        "node_id": { "$ref": "#/$defs/NodeId" }
      },
      "additionalProperties": false
    },

    "Subject": {
      "type": "object",
      "description": "The resource the event is about. `type` is the resource kind in the same words the id prefixes use (node, vm, app, deployment, domain, volume, project, lease, grant, approval, incident, agent, user, cluster, webhook); `id` is that resource's id. For certificate events the subject is the domain; for audit.chain_broken it is the cluster.",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z_]+$" },
        "id": { "type": "string", "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$" }
      },
      "additionalProperties": false
    },

    "Actor": {
      "type": "object",
      "description": "Who caused the change, when the event was caused by an identifiable actor. Absent for events produced by observation only.",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["user", "agent", "node", "system"] },
        "id": { "type": "string", "description": "`usr_`, `agt_` or `nod_` id; `system` for the control plane itself." }
      },
      "additionalProperties": false
    },

    "Selector": {
      "type": "object",
      "description": "Resource selector of a grant. A resource matches if it matches any listed entry; an app matches `projects` through its project. `{\"all\": true}` matches everything and `{}` matches nothing.",
      "properties": {
        "all": { "type": "boolean", "const": true },
        "projects": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" } },
        "apps": { "type": "array", "items": { "$ref": "#/$defs/AppId" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/NodeId" } }
      },
      "additionalProperties": false
    },

    "NodeStatus": {
      "type": "string",
      "enum": ["pending", "connected", "disconnected", "fenced", "removed"]
    },
    "VmDesiredStatus": {
      "type": "string",
      "enum": ["running", "stopped"]
    },
    "VmObservedStatus": {
      "type": "string",
      "enum": ["creating", "stopped", "starting", "running", "stopping", "crashed", "deleted", "unknown"]
    },
    "AppStatus": {
      "type": "string",
      "enum": ["deploying", "running", "degraded", "down", "stopped"]
    },
    "DeploymentStatus": {
      "type": "string",
      "enum": ["pending", "preparing", "starting", "succeeded", "failed", "superseded"]
    },
    "DeploymentPhase": {
      "type": "string",
      "enum": ["pull", "rootfs", "boot", "health", "build"]
    },
    "CertStatus": {
      "type": "string",
      "enum": ["pending", "issued", "renewing", "failed", "not_applicable"]
    },
    "GrantStatus": {
      "type": "string",
      "enum": ["active", "expired", "revoked", "exhausted"]
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": ["pending", "approved", "denied", "expired"]
    },
    "IncidentStatus": {
      "type": "string",
      "enum": ["open", "resolved"]
    },
    "LeaseMode": {
      "type": "string",
      "description": "Lease mode (D-0047). `local` for HA policy `none` and `cold`; `expiring` for `warm` and `hot`.",
      "enum": ["local", "expiring"]
    },
    "LeaseState": {
      "type": "string",
      "description": "Lease state as seen by a node (node-agent protocol).",
      "enum": ["held", "uncertain", "expired", "revoked"]
    },
    "WebhookDeliveryStatus": {
      "type": "string",
      "enum": ["pending", "delivered", "failed"]
    },

    "data_node_enrolled": {
      "type": "object",
      "description": "A node completed enrollment. Payload fields are additive within schema_version 1.",
      "required": ["node_id", "name", "roles"],
      "properties": {
        "node_id": { "$ref": "#/$defs/NodeId" },
        "name": { "type": "string" },
        "roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["node", "witness", "edge"] }
        },
        "address": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },

    "data_node_connected": {
      "type": "object",
      "description": "A node's session started (D-0011). Payload fields are additive within schema_version 1.",
      "required": ["node_id"],
      "properties": {
        "node_id": { "$ref": "#/$defs/NodeId" },
        "agent_version": { "type": "string" },
        "log_seq": { "type": "integer", "minimum": 0, "description": "Last change-log seq the node had verified when the session opened." }
      },
      "additionalProperties": true
    },

    "data_node_disconnected": {
      "type": "object",
      "description": "A node's session ended or the node missed heartbeats. Payload fields are additive within schema_version 1.",
      "required": ["node_id", "last_seen_at", "reason"],
      "properties": {
        "node_id": { "$ref": "#/$defs/NodeId" },
        "last_seen_at": { "$ref": "#/$defs/Timestamp" },
        "reason": { "type": "string", "enum": ["session_closed", "heartbeat_timeout"] }
      },
      "additionalProperties": true
    },

    "data_node_fenced": {
      "type": "object",
      "description": "A node self-fenced its stateful apps after losing their leases (D-0019). Payload fields are additive within schema_version 1.",
      "required": ["node_id", "app_ids", "lease_ids", "reason"],
      "properties": {
        "node_id": { "$ref": "#/$defs/NodeId" },
        "app_ids": { "type": "array", "items": { "$ref": "#/$defs/AppId" } },
        "lease_ids": { "type": "array", "items": { "$ref": "#/$defs/LeaseId" } },
        "reason": { "type": "string", "enum": ["lease_expired", "lease_revoked"] }
      },
      "additionalProperties": true
    },

    "data_node_disk_low": {
      "type": "object",
      "description": "A node's free disk fell below its threshold (D-0032). Payload fields are additive within schema_version 1.",
      "required": ["node_id", "free_gb", "threshold_gb"],
      "properties": {
        "node_id": { "$ref": "#/$defs/NodeId" },
        "free_gb": { "type": "number", "minimum": 0 },
        "threshold_gb": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },

    "data_vm_created": {
      "type": "object",
      "description": "A VM was created. Payload fields are additive within schema_version 1.",
      "required": ["vm_id", "node_id"],
      "properties": {
        "vm_id": { "$ref": "#/$defs/VmId" },
        "node_id": { "$ref": "#/$defs/NodeId" },
        "app_id": { "$ref": "#/$defs/AppId" }
      },
      "additionalProperties": true
    },

    "data_vm_started": {
      "type": "object",
      "description": "A VM reached `running`. Payload fields are additive within schema_version 1.",
      "required": ["vm_id", "node_id"],
      "properties": {
        "vm_id": { "$ref": "#/$defs/VmId" },
        "node_id": { "$ref": "#/$defs/NodeId" },
        "app_id": { "$ref": "#/$defs/AppId" },
        "ip": { "type": "string" }
      },
      "additionalProperties": true
    },

    "data_vm_stopped": {
      "type": "object",
      "description": "A VM stopped on request. Payload fields are additive within schema_version 1.",
      "required": ["vm_id", "node_id"],
      "properties": {
        "vm_id": { "$ref": "#/$defs/VmId" },
        "node_id": { "$ref": "#/$defs/NodeId" },
        "app_id": { "$ref": "#/$defs/AppId" },
        "exit_code": { "type": "integer" }
      },
      "additionalProperties": true
    },

    "data_vm_crashed": {
      "type": "object",
      "description": "A VM exited without being asked to stop. Payload fields are additive within schema_version 1.",
      "required": ["vm_id", "node_id", "restart_count"],
      "properties": {
        "vm_id": { "$ref": "#/$defs/VmId" },
        "node_id": { "$ref": "#/$defs/NodeId" },
        "app_id": { "$ref": "#/$defs/AppId" },
        "exit_code": { "type": "integer" },
        "restart_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },

    "data_vm_deleted": {
      "type": "object",
      "description": "A VM was deleted. Payload fields are additive within schema_version 1.",
      "required": ["vm_id", "node_id"],
      "properties": {
        "vm_id": { "$ref": "#/$defs/VmId" },
        "node_id": { "$ref": "#/$defs/NodeId" },
        "app_id": { "$ref": "#/$defs/AppId" }
      },
      "additionalProperties": true
    },

    "data_app_created": {
      "type": "object",
      "description": "An app was created. Payload fields are additive within schema_version 1.",
      "required": ["app_id", "project_id", "name", "image"],
      "properties": {
        "app_id": { "$ref": "#/$defs/AppId" },
        "project_id": { "$ref": "#/$defs/ProjectId" },
        "name": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
        "image": { "type": "string" }
      },
      "additionalProperties": true
    },

    "data_app_updated": {
      "type": "object",
      "description": "An app's settings changed. `changed` lists the app field names that were written. Payload fields are additive within schema_version 1.",
      "required": ["app_id", "changed"],
      "properties": {
        "app_id": { "$ref": "#/$defs/AppId" },
        "changed": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },

    "data_app_deleted": {
      "type": "object",
      "description": "An app was deleted. Payload fields are additive within schema_version 1.",
      "required": ["app_id", "project_id", "name"],
      "properties": {
        "app_id": { "$ref": "#/$defs/AppId" },
        "project_id": { "$ref": "#/$defs/ProjectId" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },

    "data_app_down": {
      "type": "object",
      "description": "An app's health check failed past its threshold, or its VM crashed (D-0032). Payload fields are additive within schema_version 1.",
      "required": ["app_id", "node_id", "check", "failures"],
      "properties": {
        "app_id": { "$ref": "#/$defs/AppId" },
        "node_id": { "$ref": "#/$defs/NodeId" },
        "vm_id": { "$ref": "#/$defs/VmId" },
